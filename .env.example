# Copy to .env.local for local development.
# These variables are not read by the app yet. Leave them empty until a later change needs them.
# Never commit real secrets. .env.local and other .env* files are gitignored; this example is the exception.

# Neon Postgres connection string.
DATABASE_URL=

# Shared family login username.
AUTH_USERNAME=

# Hash of the shared family password. Do not put the plaintext password here.
AUTH_PASSWORD_HASH=

# Secret used to sign the session cookie.
SESSION_SECRET=

# Notion internal integration token (read-only). Used later by the import script.
NOTION_TOKEN=

# Notion database id for the dish catalog.
NOTION_DATABASE_ID=
