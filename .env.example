# Copy to .env.local for local development.
# Never commit real secrets. .env.local and other .env* files are gitignored; this example is the exception.

# Neon Postgres pooled connection string. The app reads this at runtime.
DATABASE_URL=

# Neon direct (unpooled) connection string. Migrations prefer this and fall back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Shared family login username. Matched exactly.
AUTH_USERNAME=

# bcrypt hash of the shared family password. Generate with `pnpm auth:hash`
# (read from stdin, not echoed, never passed as an argument). Do not put the plaintext password here.
AUTH_PASSWORD_HASH=

# Secret used to sign the session cookie. At least 32 characters.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Notion internal integration token (read-only). Set on Vercel for Production and Preview.
# Do not commit a real token. CI does not need it.
NOTION_TOKEN=

# Recipe database id. Not a secret. The app uses this when the variable is unset.
NOTION_DATABASE_ID=ff95d9e83ae144ffaaa461286c9652ad

# Data source inside that database. Not a secret. The app uses this when the variable is unset.
NOTION_DATA_SOURCE_ID=b8a7d4f9-5bfd-4ed3-bacd-5a5298796038

# Shared secret for the daily Notion cron. At least 16 characters.
# Vercel sends it as Authorization: Bearer. Generate with: openssl rand -base64 32
CRON_SECRET=
