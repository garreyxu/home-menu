# Neon pooled Postgres connection string used at runtime.
DATABASE_URL=
# Neon direct Postgres connection string preferred by migrations.
DATABASE_URL_UNPOOLED=
# Shared login username, matched exactly.
AUTH_USERNAME=
# bcrypt hash of the shared password, generated with pnpm auth:hash.
AUTH_PASSWORD_HASH=
# Session signing secret of at least 32 characters.
SESSION_SECRET=
# Read-only Notion integration token, required only for import.
NOTION_TOKEN=
# Notion recipe database identifier, required only for import.
NOTION_DATABASE_ID=
# Notion recipe data-source identifier, required only for import.
NOTION_DATA_SOURCE_ID=
# Bearer secret of at least 16 characters for the daily import cron.
CRON_SECRET=
